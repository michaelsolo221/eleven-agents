{
    "name": "Sales Agent",
    "conversation_config": {
        "asr": {
            "quality": "high",
            "provider": "scribe_realtime",
            "user_input_audio_format": "pcm_16000",
            "keywords": []
        },
        "turn": {
            "turn_timeout": 7,
            "silence_end_call_timeout": -1,
            "turn_eagerness": "normal",
            "turn_model": "turn_v3",
            "mode": "turn"
        },
        "tts": {
            "model_id": "eleven_flash_v2",
            "voice_id": "21m00Tcm4TlvDq8ikWAM",
            "supported_voices": [],
            "agent_output_audio_format": "pcm_16000",
            "optimize_streaming_latency": 3,
            "stability": 0.5,
            "speed": 1,
            "similarity_boost": 0.8,
            "text_normalisation_type": "elevenlabs",
            "pronunciation_dictionary_locators": []
        },
        "conversation": {
            "text_only": false,
            "max_duration_seconds": 600,
            "client_events": ["audio", "interruption"]
        },
        "language_presets": {},
        "agent": {
            "first_message": "Hi there! I'm your sales assistant. How can I help you today — looking for product info, pricing, or something else?",
            "language": "en",
            "dynamic_variables": {
                "dynamic_variable_placeholders": {}
            },
            "prompt": {
                "prompt": "# Personality\nYou are a friendly, professional sales assistant for our company on WhatsApp.\n\n# Environment\nYou work on WhatsApp, handling both text and voice messages from customers.\n\n# Tone\n- Warm and approachable, but not pushy\n- Concise — this is WhatsApp, not email\n- Natural and conversational when responding to voice notes\n- Use the customer's name if you know it\n\n# Goal\n1. Answer questions about products, services, and pricing\n2. Help customers find what they need\n3. Guide them toward a purchase decision\n4. Handle objections gracefully\n5. For complex inquiries, offer to connect them with a human sales rep\n\n# Guardrails\n- If you don't know something, say so honestly — never fabricate product details or pricing\n- Never share internal pricing structures or competitor comparisons\n- Do not make promises about delivery dates or stock without confirming via tools\n- Keep responses under 3 sentences unless the user asks for details",
                "llm": "gemini-2.5-flash",
                "temperature": 0.7,
                "max_tokens": -1,
                "tool_ids": [],
                "mcp_server_ids": [],
                "native_mcp_server_ids": [],
                "knowledge_base": [],
                "ignore_default_personality": false,
                "built_in_tools": {
                    "end_call": {
                        "name": "end_call",
                        "params": {
                            "system_tool_type": "end_call"
                        }
                    }
                },
                "rag": {
                    "enabled": false,
                    "embedding_model": "e5_mistral_7b_instruct",
                    "max_vector_distance": 0.6,
                    "max_documents_length": 50000,
                    "max_retrieved_rag_chunks_count": 20
                },
                "custom_llm": null
            }
        }
    },
    "platform_settings": {
        "auth": {
            "enable_auth": false,
            "allowlist": [],
            "shareable_token": null
        },
        "evaluation": {
            "criteria": []
        },
        "guardrails": {
            "version": "1",
            "focus": { "is_enabled": true },
            "prompt_injection": { "is_enabled": true },
            "content": {
                "config": {
                    "harassment": { "is_enabled": true, "threshold": 0.5 },
                    "profanity": { "is_enabled": true, "threshold": 0.5 }
                }
            },
            "custom": { "config": { "configs": [] } }
        },
        "widget": {
            "variant": "full",
            "placement": "bottom-right",
            "expandable": "never",
            "avatar": { "type": "orb", "color_1": "#2792dc", "color_2": "#9ce6e6" },
            "feedback_mode": "none",
            "bg_color": "#ffffff",
            "text_color": "#000000",
            "btn_color": "#000000",
            "btn_text_color": "#ffffff",
            "border_color": "#e1e1e1",
            "focus_color": "#000000",
            "shareable_page_show_terms": true,
            "show_avatar_when_collapsed": false,
            "disable_banner": false,
            "mic_muting_enabled": false,
            "transcript_enabled": false,
            "text_input_enabled": true,
            "text_contents": {},
            "language_selector": false,
            "supports_text_only": true,
            "language_presets": {},
            "styles": {}
        },
        "data_collection": {},
        "overrides": {
            "conversation_config_override": {
                "tts": { "voice_id": false },
                "conversation": { "text_only": true },
                "agent": {
                    "first_message": false,
                    "language": false,
                    "prompt": { "prompt": false }
                }
            },
            "custom_llm_extra_body": false,
            "enable_conversation_initiation_client_data_from_webhook": false
        },
        "call_limits": {
            "agent_concurrency_limit": -1,
            "daily_limit": 100000,
            "bursting_enabled": true
        },
        "privacy": {
            "record_voice": true,
            "retention_days": -1,
            "delete_transcript_and_pii": false,
            "delete_audio": false,
            "apply_to_existing_conversations": false,
            "zero_retention_mode": false
        },
        "workspace_overrides": {
            "webhooks": { "post_call_webhook_id": null },
            "conversation_initiation_client_data_webhook": null
        },
        "safety": {
            "is_blocked_ivc": false,
            "is_blocked_non_ivc": false,
            "ignore_safety_evaluation": false
        },
        "testing": { "attached_tests": [] },
        "ban": null
    },
    "tags": []
}
